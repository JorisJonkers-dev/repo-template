# One pipeline ending in "Pipeline Complete", the only required check (estate convention).
# ONE job: GitHub bills each job rounded up to a full minute, so checks are steps, not jobs.
# Steps run `task` targets so CI and `task check` cannot drift, and carry
# `if: ${{ !cancelled() }}` so one failure still surfaces the rest.
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref == 'refs/heads/main' && github.sha || github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}

permissions:
  contents: read

jobs:
  pipeline-complete:
    name: Pipeline Complete
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # Go modules come through the estate's package proxy (JorisJonkers-dev/workspace#167).
      - uses: JorisJonkers-dev/github-workflows/actions/setup-package-proxy@8b5462a796f022647dfc44123ddb3655cc3c2f28 # v0.45.3
        with:
          token: ${{ secrets.PACKAGES_PROXY_TOKEN }}
          require-package-proxy: true

      - uses: jdx/mise-action@f5be966e4a917d54244728e6a5fdcd1d93a35e6c # v5.2.6
        with:
          cache: true

      - name: Format
        if: ${{ !cancelled() }}
        run: task fmt

      - name: Lint Go
        if: ${{ !cancelled() }}
        run: task lint:go

      - name: Lint migrations
        if: ${{ !cancelled() }}
        run: task lint:sql

      - name: Lint workflows
        if: ${{ !cancelled() }}
        run: task lint:actions

      - name: Vet
        if: ${{ !cancelled() }}
        run: task vet

      - name: Test (race) and coverage
        if: ${{ !cancelled() }}
        run: task test

      - name: Build
        if: ${{ !cancelled() }}
        run: task build

      - name: Container image builds
        if: ${{ !cancelled() }}
        env:
          PACKAGES_PROXY_TOKEN: ${{ secrets.PACKAGES_PROXY_TOKEN }}
        run: |
          set -euo pipefail
          args=()
          if [ -n "$PACKAGES_PROXY_TOKEN" ]; then
            printf '::add-mask::%s\n' "$PACKAGES_PROXY_TOKEN"
            umask 077
            netrc="$RUNNER_TEMP/packages-netrc"
            {
              printf 'machine packages.jorisjonkers.dev\n'
              printf 'login packages\n'
              printf 'password %s\n' "$PACKAGES_PROXY_TOKEN"
            } > "$netrc"
            args+=(--secret "id=packages-netrc,src=$netrc"
              --build-arg GOPROXY=https://packages.jorisjonkers.dev/go)
          fi
          docker build --build-arg VERSION=ci "${args[@]}" -t {{service_name}}:ci .
