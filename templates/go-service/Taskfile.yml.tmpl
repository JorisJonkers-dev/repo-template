# One command per loop. `task` lists targets; `task check` is what CI runs.
version: "3"

vars:
  APP: "{{service_name}}"
  COVERAGE_MIN: 80

tasks:
  default:
    cmd: task --list
    silent: true

  fmt:
    desc: Fail if any file is not gofumpt/goimports formatted
    cmd: golangci-lint fmt --diff ./...

  lint:
    desc: All linters
    cmds:
      - task: lint:go
      - task: lint:sql
      - task: lint:actions

  lint:go:
    desc: golangci-lint
    cmd: golangci-lint run ./...

  lint:sql:
    desc: Migration safety lint (squawk); a no-op until db/migrations exists
    cmd: |
      set -- db/migrations/*.sql
      if [ -e "$1" ]; then
        squawk "$@"
      else
        echo "no migrations; skipped squawk"
      fi

  lint:actions:
    desc: actionlint on every workflow
    cmd: actionlint

  vet:
    desc: go vet
    cmd: go vet ./...

  test:
    desc: Go tests with the race detector and a {{.COVERAGE_MIN}}% statement coverage gate
    cmds:
      - go test -race -count=1 -covermode=atomic -coverprofile=coverage.out ./...
      - |
        total="$(go tool cover -func=coverage.out | awk '/^total:/ { sub("%", "", $3); print $3 }')"
        echo "coverage: ${total}% (minimum {{.COVERAGE_MIN}}%)"
        awk -v t="$total" -v m="{{.COVERAGE_MIN}}" 'BEGIN { exit !(t >= m) }'

  build:
    desc: Build the service binary
    env:
      CGO_ENABLED: "0"
    cmd: go build -trimpath -o bin/{{.APP}} ./cmd/{{.APP}}

  check:
    desc: Everything CI runs on a pull request
    cmds:
      - task: fmt
      - task: lint
      - task: vet
      - task: test
      - task: build

  fix:
    desc: Apply formatters and autofixes
    cmds:
      - golangci-lint fmt ./...
      - golangci-lint run --fix ./...

  run:
    desc: Run the service locally on :8080
    cmd: go run ./cmd/{{.APP}}
