name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}

permissions:
  contents: read

jobs:
  verify:
    uses: JorisJonkers-dev/github-workflows/.github/workflows/node-ci.yml@8b5462a796f022647dfc44123ddb3655cc3c2f28 # v0.45.3
    with:
      require-package-proxy: true
      node-version: '24'
      package-manager: pnpm
      working-directory: '.'
      install-command: pnpm install --frozen-lockfile
      lint-command: pnpm lint
      typecheck-command: pnpm typecheck
      test-command: pnpm test
      build-command: pnpm build
      package-check-command: pnpm pack --dry-run
    secrets: inherit

  pipeline-complete:
    name: Pipeline Complete
    if: always()
    needs: [verify]
    runs-on: ubuntu-latest
    steps:
      - uses: re-actors/alls-green@release/v1
        with:
          jobs: ${{ toJSON(needs) }}
